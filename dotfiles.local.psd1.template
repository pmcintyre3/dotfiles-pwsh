# Install-time settings for this machine. Not committed (see .gitignore).
# Created from dotfiles.local.psd1.template by script/bootstrap.ps1. See design.md section 7.
@{
    # Topics this machine skips entirely: installers, links, and profile loading. Example: @('ai')
    ExcludeTopics = @()

    # Machine-wide changes (HKLM settings, machine-scope packages):
    #   Never  - never.
    #   Prompt - only when you run `dot -Elevated` (one UAC prompt).
    #   Auto   - like Prompt, and also inline whenever dot already runs elevated.
    Elevation     = 'Never'

    # PowerShell repository for module installs (an internal feed on locked-down machines).
    PSRepository  = 'PSGallery'

    # Package groups from packages/packages.psd1 to install: core, dev, apps, personal.
    PackageGroups = @('core', 'dev')
}
